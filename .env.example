# Copy this file to .env for local development. Never put a real token in this file.
DISCORD_APPLICATION_ID=replace-with-discord-application-id
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_IDS=replace-with-first-guild-id,replace-with-second-guild-id
DISCORD_MESSAGE_CONTENT_INTENT_ENABLED=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
LOG_LEVEL=info
